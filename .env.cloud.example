# Copy to .env.cloud and replace every REPLACE_* value.
# Never commit the real .env.cloud file.

FREELLM_DOMAIN=gateway.example.com

FREELLM_GATEWAY_HOST=0.0.0.0
FREELLM_GATEWAY_PORT=8765
PORT=8765

FREELLM_GATEWAY_API_TOKEN=REPLACE_WITH_LONG_RANDOM_API_TOKEN
FREELLM_GATEWAY_ADMIN_TOKEN=REPLACE_WITH_DIFFERENT_LONG_RANDOM_ADMIN_TOKEN
FREELLM_GATEWAY_REQUIRE_EXPLICIT_TOKENS=1

FREELLM_GATEWAY_DB=/data/gateway.sqlite3
FREELLM_GATEWAY_CATALOG_OUTPUT=/data/catalog-export.json
FREELLM_GATEWAY_LOG=/data/gateway.log
FREELLM_GATEWAY_CONNECTION_LOG=/data/gateway-connections.jsonl

# 32 random bytes encoded with URL-safe base64 (Fernet key).
# Keep this key outside the persistent volume backup as a separate secret.
FREELLM_GATEWAY_SECRET_KEY=REPLACE_WITH_FERNET_KEY
FREELLM_GATEWAY_SECRETS_FILE=/data/provider-secrets.json

FREELLM_GATEWAY_CATALOG_SOURCE=https://freellm.top/data/offers.json
